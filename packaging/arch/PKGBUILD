# Maintainer: Xomel45
# Builds the tagged release from source (the tag must exist in the GitHub repository).
# In a checkout of the app: cd packaging/arch && OPENSCHOOL_UNPINNED=1 makepkg -si
pkgname=openschool
pkgver=0.1.0
pkgrel=1
# The commit the tag points to: fill it in when the tag is made (`git rev-parse v$pkgver^{commit}`). A tag that was moved afterwards
# stops the build instead of building other code. The bridge is pinned by that commit: it is a submodule, checked out at the recorded one.
# The check fails closed: an empty value refuses to build. The copy kept inside the project's own repository cannot contain the hash of
# the commit it is part of, so there (and in the project's CI) the build is started with OPENSCHOOL_UNPINNED=1.
_commit=''
pkgdesc='Unofficial desktop client for «Моя школа» (Gosuslugi): schedule, marks, homework'
arch=(x86_64)
url='https://github.com/Xomel45/OpenSchool-Desktop'
license=(MPL-2.0)
depends=(webkit2gtk-4.1 gtk3 libayatana-appindicator dbus)
makedepends=(cargo cmake git)
optdepends=('kwallet: remember the login between starts (any Secret Service provider works)'
            'gnome-keyring: remember the login between starts (any Secret Service provider works)')
# The bridge is a git submodule of the app: it is cloned next to it and wired in prepare().
source=("$pkgname::git+$url.git#tag=v$pkgver"
        "OpenSchool-Bridge::git+https://github.com/Xomel45/OpenSchool-Bridge.git")
sha256sums=('SKIP' 'SKIP')

prepare() {
  cd "$pkgname"
  if [[ -z $_commit ]]; then
    if [[ ${OPENSCHOOL_UNPINNED:-} != 1 ]]; then
      echo "_commit is empty: refusing to build an unpinned tag (fill it in, or set OPENSCHOOL_UNPINNED=1 for a build from the project's own checkout)." >&2
      return 1
    fi
    echo "==> WARNING: building v$pkgver without a pinned commit" >&2
  elif [[ $(git rev-parse HEAD) != "$_commit" ]]; then
    echo "The tag v$pkgver does not point to $_commit any more: refusing to build." >&2
    return 1
  fi
  git submodule init
  git config submodule.bridge.url "$srcdir/OpenSchool-Bridge"
  git -c protocol.file.allow=always submodule update
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu" --manifest-path src-tauri/Cargo.toml
}

build() {
  cd "$pkgname/src-tauri"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  # aws-lc (the TLS library under reqwest) builds one file with -O0 and refuses the -O2/-flto the distribution adds after it.
  # Only those are removed: the hardening flags (_FORTIFY_SOURCE, stack protector, CET, ...) stay.
  CFLAGS=$(sed -E 's/(^| )-O([0-9sz]|fast)( |$)/\1\3/g; s/ ?-flto(=[A-Za-z0-9]+)?//g' <<<"$CFLAGS")
  CXXFLAGS=$(sed -E 's/(^| )-O([0-9sz]|fast)( |$)/\1\3/g; s/ ?-flto(=[A-Za-z0-9]+)?//g' <<<"$CXXFLAGS")
  export CFLAGS CXXFLAGS
  cargo build --frozen --release
}

check() {
  cd "$pkgname/src-tauri"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  # aws-lc (the TLS library under reqwest) builds one file with -O0 and refuses the -O2/-flto the distribution adds after it.
  # Only those are removed: the hardening flags (_FORTIFY_SOURCE, stack protector, CET, ...) stay.
  CFLAGS=$(sed -E 's/(^| )-O([0-9sz]|fast)( |$)/\1\3/g; s/ ?-flto(=[A-Za-z0-9]+)?//g' <<<"$CFLAGS")
  CXXFLAGS=$(sed -E 's/(^| )-O([0-9sz]|fast)( |$)/\1\3/g; s/ ?-flto(=[A-Za-z0-9]+)?//g' <<<"$CXXFLAGS")
  export CFLAGS CXXFLAGS
  cargo test --frozen
}

package() {
  cd "$pkgname"
  install -Dm755 src-tauri/target/release/openschool_desktop "$pkgdir/usr/bin/openschool_desktop"
  install -Dm644 packaging/openschool.desktop "$pkgdir/usr/share/applications/openschool.desktop"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/openschool_desktop.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/openschool_desktop.png"
  install -Dm644 'src-tauri/icons/128x128@2x.png' "$pkgdir/usr/share/icons/hicolor/256x256/apps/openschool_desktop.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
